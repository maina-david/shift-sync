# ── Server ──────────────────────────────────────────────────────────────────
PORT=3001
NODE_ENV=development

# Frontend origin — used for CORS and links inside notification emails
FRONTEND_URL=http://localhost:3000

# ── Database (MySQL 8) ───────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=
DB_DATABASE=shift_sync

# ── JWT ──────────────────────────────────────────────────────────────────────
# Use two DIFFERENT secrets, each at least 32 random characters
JWT_SECRET=change_me_to_a_strong_random_secret_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=change_me_to_a_different_strong_random_secret_at_least_32_chars
JWT_REFRESH_EXPIRES_IN=7d

# ── SMTP (Nodemailer) ─────────────────────────────────────────────────────────
# Defaults below work with a free Mailtrap sandbox account
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ShiftSync <noreply@shiftsync.dev>"
